{
    "name": "xtb2sure",
    "version": "0.1.0",
    "description": "Convert XTB .xlsx exports into Sure-compatible CSV files",
    "main": "src/index.ts",
    "engines": {
        "node": "24"
    },
    "type": "module",
    "license": "MIT",
    "bin": {
        "xtb2sure": "./src/cli.ts"
    },
    "scripts": {
        "dev": "node --experimental-transform-types --watch src/index.ts",
        "convert": "node --experimental-transform-types ./src/cli.ts convert",
        "format": "biome format --write .",
        "knip": "knip",
        "lint-fix": "biome check --write .",
        "lint": "biome check .",
        "prepare": "husky",
        "release": "release-it",
        "start": "node --experimental-transform-types src/index.ts",
        "test": "node --experimental-transform-types --test",
        "typecheck": "tsc --noEmit"
    },
    "lint-staged": {
        "*": [
            "biome check --write --no-errors-on-unmatched"
        ]
    },
    "imports": {
        "#*": "./src/*"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@commitlint/cli": "21.2.3",
        "@commitlint/config-conventional": "21.2.3",
        "@release-it/conventional-changelog": "12.0.2",
        "@types/node": "24.19.1",
        "husky": "9.1.7",
        "knip": "6.41.0",
        "lint-staged": "17.6.0",
        "release-it": "21.1.1",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "commander": "15.0.0",
        "csv-stringify": "6.9.0",
        "xlsx": "0.18.5"
    }
}
