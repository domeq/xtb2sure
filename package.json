{
    "name": "@jaskrowo/xtb2sure",
    "version": "0.2.3",
    "description": "Convert XTB .xlsx exports into Sure-compatible CSV files",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "engines": {
        "node": ">=24"
    },
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/domeq/xtb2sure.git"
    },
    "files": [
        "dist",
        "bin"
    ],
    "bin": {
        "xtb2sure": "./bin/xtb2sure.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "node --watch src/index.ts",
        "convert": "node ./src/cli.ts convert",
        "format": "biome format --write .",
        "knip": "knip",
        "lint-fix": "biome check --write .",
        "lint": "biome check .",
        "prepack": "npm run build",
        "prepare": "husky",
        "release": "release-it",
        "start": "node src/index.ts",
        "test": "node --test",
        "typecheck": "tsc --noEmit"
    },
    "lint-staged": {
        "*": [
            "biome check --write --no-errors-on-unmatched"
        ]
    },
    "imports": {
        "#*": "./dist/*"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@commitlint/cli": "21.2.3",
        "@commitlint/config-conventional": "21.2.3",
        "@release-it/conventional-changelog": "12.0.2",
        "@types/node": "24.19.1",
        "husky": "9.1.7",
        "knip": "6.41.0",
        "lint-staged": "17.6.0",
        "release-it": "21.1.1",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "commander": "15.0.0",
        "csv-stringify": "6.9.0",
        "xlsx": "0.18.5"
    }
}
