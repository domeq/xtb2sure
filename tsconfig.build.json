{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "rewriteRelativeImportExtensions": true,
        "allowImportingTsExtensions": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "test", "bin"]
}
